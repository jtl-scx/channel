{
    "name": "jtl-scx/channel",
    "license": "MIT",
    "require": {
        "php": "8.4.*",
        "symfony/console": "^v6.4.35",
        "symfony/dotenv": "^v6.4.35",
        "jtl-scx/channel-core": "^2.2.0",
        "monolog/monolog": "^2.11.0",
        "twig/twig": "^v3.24.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^v3.94.2",
        "psalm/phar": "^6.16.1",
        "phpunit/phpunit": "^13.0.5"
    },
    "autoload": {
        "psr-4": {
            "JTL\\SCX\\Channel\\": "src/"
        }
    },
    "scripts": {
        "phpcs": [
            "vendor/bin/php-cs-fixer fix src --rules=@PSR12"
        ],
        "phpcs-dry": [
            "vendor/bin/php-cs-fixer fix src --rules=@PSR12 --dry-run"
        ],
        "psalm": [
            "vendor/bin/psalm.phar"
        ]
    },
    "prefer-stable" : true
}
